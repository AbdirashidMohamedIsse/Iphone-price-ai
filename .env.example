# --- OpenAI -----------------------------------------------------------------
OPENAI_API_KEY=
# Cheap/fast model for search planning, discovery, extraction, validation
OPENAI_MODEL=gpt-5-mini
# Stronger model for the buying recommendation
OPENAI_MODEL_RECOMMENDATION=gpt-5

# --- Web search + scraping ---------------------------------------------------
SERPER_API_KEY=
FIRECRAWL_API_KEY=
SEARCH_COUNTRY=us

# --- MongoDB -----------------------------------------------------------------
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net
MONGODB_DB=iphone_price_ai

# --- Inngest (workflow runner) -------------------------------------------------
# Not needed locally when using `npm run inngest` (Inngest dev server).
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- App behaviour -----------------------------------------------------------
# Bearer token required by /api/agents/* (min 16 chars). Leave empty to disable those routes.
INTERNAL_API_KEY=
MAX_PAGES=8
CACHE_TTL_MINUTES=15
RATE_LIMIT_PER_MINUTE=6
